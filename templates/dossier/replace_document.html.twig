{% extends 'base.html.twig' %}

{% block title %}Remplacer un document{% endblock %}

{% block body %}
<a href="{{ path('app_espace_client_dossier_show', {'id': document.dossier.id}) }}" class="btn btn-outline-secondary btn-sm mb-3">&larr; Retour au dossier</a>

<h1 class="h4 mb-4">Remplacer un document</h1>

<div class="alert alert-warning">
    <strong>Motif du rejet :</strong> {{ document.motifRejet }}
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_row(form.nouveauFichier) }}
            <button type="submit" class="btn btn-primary mt-3">Envoyer le nouveau document</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
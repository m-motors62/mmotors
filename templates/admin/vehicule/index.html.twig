{% extends 'admin/base.html.twig' %}

{% block title %}Véhicules{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.11/css/dataTables.bootstrap5.min.css">
{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Véhicules</h1>
    <div class="d-flex align-items-center gap-3">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="toggle-archives" {{ includeArchived ? 'checked' }}>
            <label class="form-check-label" for="toggle-archives">Afficher les archivés</label>
        </div>
        <a href="{{ path('app_admin_vehicule_new_location') }}" class="btn btn-primary">Ajouter (location)</a>
        <a href="{{ path('app_admin_vehicule_new_vente') }}" class="btn btn-primary">Ajouter (vente)</a>
    </div>
</div>

<table class="table table-striped bg-white" id="vehicule-table">
    <thead>
        <tr>
            <th>Marque / Modèle</th>
            <th>Immatriculation</th>
            <th>Statut</th>
            <th>Prix</th>
            <th>Photos</th>
            <th>Ajouté le</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for vehicule in vehicules %}
        <tr class="{{ vehicule.isArchived ? 'opacity-50' }}">
            <td>
                <a href="{{ path('app_admin_vehicule_edit', {'id': vehicule.id}) }}" class="text-decoration-none fw-semibold">
                    {{ vehicule.marque }} {{ vehicule.modele }}
                </a>
            </td>
            <td>{{ vehicule.immatriculation }}</td>
            <td>
                {% if vehicule.statut == 'location' %}
                    <span class="badge bg-info">Location</span>
                {% else %}
                    <span class="badge bg-warning">Vente</span>
                {% endif %}
                {% if vehicule.isArchived %}
                    <span class="badge bg-secondary">Archivé</span>
                {% endif %}
            </td>
            <td>{{ vehicule.prix }} €</td>
            <td>{{ vehicule.vehiculePhotos|length }}</td>
            <td>{{ vehicule.dateCreation|date('d/m/Y H:i') }}</td>
            <td class="text-end">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        Actions
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if vehicule.id not in vehiculeIdsWithActiveDossier %}
                            <li>
                                <button type="button" class="dropdown-item btn-toggle-statut-vehicule" data-vehicule-id="{{ vehicule.id }}" data-bs-toggle="modal" data-bs-target="#toggleStatutModal">
                                    {{ vehicule.statut == 'location' ? 'Basculer en vente' : 'Basculer en location' }}
                                </button>
                            </li>
                            {% if not vehicule.isArchived %}
                            <li>
                                <button type="button" class="dropdown-item btn-toggle-archive-vehicule" data-vehicule-id="{{ vehicule.id }}">
                                    Archiver
                                </button>
                            </li>
                            {% endif %}
                        {% endif %}
                        {% if vehicule.isArchived %}
                        <li>
                            <button type="button" class="dropdown-item btn-toggle-archive-vehicule" data-vehicule-id="{{ vehicule.id }}">
                                Désarchiver
                            </button>
                        </li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button" class="dropdown-item text-danger btn-delete-vehicule" data-vehicule-id="{{ vehicule.id }}">
                                Supprimer
                            </button>
                        </li>
                        {% if vehicule.id in vehiculeIdsWithActiveDossier %}
                        <li><span class="dropdown-item-text text-muted small">Dossier actif — actions limitées</span></li>
                        {% endif %}
                    </ul>
                </div>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="7" class="text-center text-muted">Aucun véhicule enregistré.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<div class="modal fade" id="toggleStatutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Changement de statut</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="toggle-statut-container">
                <!-- Charge dynamiquement -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.11/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.11/js/dataTables.bootstrap5.min.js"></script>
<script>
$(document).ready(function() {
    $('#vehicule-table').DataTable({
        order: [[5, 'desc']],
        language: {
            search: "Rechercher :",
            lengthMenu: "Afficher _MENU_ véhicules",
            info: "_START_ à _END_ sur _TOTAL_ véhicules",
            infoEmpty: "Aucun véhicule",
            paginate: {
                previous: "Précédent",
                next: "Suivant"
            },
            zeroRecords: "Aucun véhicule ne correspond à la recherche"
        },
        columnDefs: [
            { orderable: false, targets: -1 }
        ]
    });

    $('#toggle-archives').on('change', function() {
        var url = new URL(window.location.href);
        if ($(this).is(':checked')) {
            url.searchParams.set('archives', '1');
        } else {
            url.searchParams.delete('archives');
        }
        window.location.href = url.toString();
    });

    $(document).on('click', '.btn-toggle-archive-vehicule', function() {
        var vehiculeId = $(this).data('vehicule-id');
        var url = '{{ path('app_admin_vehicule_index') }}/' + vehiculeId + '/archiver';

        $.ajax({
            url: url,
            method: 'POST',
            success: function(response) {
                if (response.success) {
                    window.location.reload();
                }
            },
            error: function(xhr) {
                alert(xhr.responseJSON.message);
            }
        });
    });

    $(document).on('click', '.btn-delete-vehicule', function() {
        if (!confirm('Supprimer definitivement ce vehicule ? Cette action est irreversible.')) {
            return;
        }

        var vehiculeId = $(this).data('vehicule-id');
        var url = '{{ path('app_admin_vehicule_index') }}/' + vehiculeId + '/supprimer';

        $.ajax({
            url: url,
            method: 'POST',
            success: function(response) {
                if (response.success) {
                    window.location.reload();
                }
            },
            error: function(xhr) {
                alert(xhr.responseJSON.message);
            }
        });
    });

    $(document).on('click', '.btn-toggle-statut-vehicule', function() {
        var vehiculeId = $(this).data('vehicule-id');
        var url = '{{ path('app_admin_vehicule_index') }}/' + vehiculeId + '/basculer';

        $.get(url, function(html) {
            $('#toggle-statut-container').html(html);
        });

        $(document).off('submit', '#toggle-statut-form').on('submit', '#toggle-statut-form', function(e) {
            e.preventDefault();
            var $form = $(this);

            $.ajax({
                url: url,
                method: 'POST',
                data: $form.serialize(),
                success: function(response) {
                    if (response.success) {
                        window.location.reload();
                    }
                },
                error: function(xhr) {
                    $('#toggle-statut-container').html(xhr.responseJSON.html);
                }
            });
        });
    });
});
</script>
{% endblock %}
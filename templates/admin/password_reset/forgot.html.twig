{% extends 'admin/base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm mt-5">
            <div class="card-body p-4">
                <h1 class="h4 mb-3 text-center">Mot de passe oublié</h1>
                <p class="text-muted small">Entrez l'adresse de votre compte pour recevoir un lien de réinitialisation.</p>
                {{ form_start(form) }}
                    {{ form_row(form.email) }}
                    <button type="submit" class="btn btn-primary w-100 mt-3">Envoyer</button>
                {{ form_end(form) }}
                <p class="text-center mt-3 mb-0"><a href="{{ path('app_admin_login') }}" class="small">Retour à la connexion</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
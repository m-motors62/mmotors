{% extends 'admin/base.html.twig' %}

{% block title %}Dossier — {{ dossier.client.contact.prenom }} {{ dossier.client.contact.nom }}{% endblock %}

{% block body %}
<a href="{{ path('app_admin_dossier_index') }}" class="btn btn-outline-secondary btn-sm mb-3">&larr; Retour aux dossiers</a>

<h1 class="h4 mb-2">{{ dossier.client.contact.prenom }} {{ dossier.client.contact.nom }}</h1>
<p class="text-muted mb-4">{{ dossier.type == 'location' ? 'Demande de location' : 'Offre d\'achat' }} — déposé le {{ dossier.dateCreation|date('d/m/Y H:i') }}</p>

{% if dossier.id in aTraiterIds %}
<div class="alert alert-info">
    Ce dossier a été modifié depuis votre dernière visite. Vérifiez les pièces mises à jour ci-dessous.
</div>
{% endif %}

{% if dossier.type == 'location' and dossier.statut == 'en_cours' %}
    {% set joursEcoules = date().diff(dossier.dateCreation).days %}
    {% if joursEcoules > 30 %}
    <div class="alert alert-warning">
        <strong>Attention :</strong> ce dossier a été déposé il y a {{ joursEcoules }} jours.
        Les fiches de paie fournies ne sont probablement plus assez récentes — envisagez de
        demander au client de les redéposer avant de valider.
    </div>
    {% endif %}
{% endif %}
<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6">Client</h2>
                <p class="mb-1">{{ dossier.client.contact.prenom }} {{ dossier.client.contact.nom }}</p>
                <p class="mb-1 text-muted small">{{ dossier.client.contact.email }}</p>
                <p class="mb-0 text-muted small">{{ dossier.client.contact.telephone }}</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6">Véhicule</h2>
                <p class="mb-1"><strong>{{ dossier.vehicule.marque }} {{ dossier.vehicule.modele }}</strong></p>
                <p class="text-muted small mb-0">{{ dossier.vehicule.immatriculation }} — {{ dossier.vehicule.prix }} €</p>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h6">Statut</h2>
                {% if dossier.statut == 'en_cours' %}
                    <span class="badge bg-warning fs-6">En cours</span>

                    {% if not is_granted('ROLE_ADMIN') %}
                        {% set tousDocumentsValides = true %}
                        {% for document in dossier.documents %}
                            {% if not document.estRemplace and document.statut != 'valide' %}
                                {% set tousDocumentsValides = false %}
                            {% endif %}
                        {% endfor %}

                        <div class="mt-3">
                            {% if tousDocumentsValides %}
                                <form method="post" action="{{ path('app_admin_dossier_valider', {'id': dossier.id}) }}" class="d-inline">
                                    <button type="submit" class="btn btn-success btn-sm">Valider le dossier</button>
                                </form>
                            {% else %}
                                <button type="button" class="btn btn-success btn-sm" disabled title="Tous les documents doivent etre valides individuellement">Valider le dossier</button>
                            {% endif %}
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#refuserModal">Refuser le dossier</button>
                        </div>
                        {% endif %}
                {% elseif dossier.statut == 'valide' %}
                    <span class="badge bg-success fs-6">Validé</span>
                {% elseif dossier.statut == 'refuse' %}
                    <span class="badge bg-danger fs-6">Refusé</span>
                    {% if dossier.motifRefus %}
                        <p class="text-muted small mt-2 mb-0">Motif : {{ dossier.motifRefus }}</p>
                    {% endif %}
                {% elseif dossier.statut == 'termine' %}
                    <span class="badge bg-secondary fs-6">Terminé</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-3">Documents déposés</h2>
                <ul class="list-group list-group-flush">
                    {% for document in dossier.documents %}
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>
                                {{ {
                                    'carte_identite': 'Carte d\'identité',
                                    'justificatif_domicile': 'Justificatif de domicile',
                                    'fiche_paie': 'Fiche de paie'
                                }[document.typeDocument] ?? document.typeDocument }}
                            </span>
                            <div>
                                {% if document.statut == 'valide' %}
                                    <span class="badge bg-success me-2">Validé</span>
                                {% elseif document.statut == 'rejete' %}
                                    <span class="badge bg-danger me-2">Rejeté</span>
                                {% else %}
                                    <span class="badge bg-secondary me-2">En attente</span>
                                {% endif %}

                                {% if not is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_admin_document_download', {'id': document.id}) }}" target="_blank" class="btn btn-sm btn-outline-primary">Voir</a>
                                {% else %}
                                <span class="text-muted small">Accès restreint</span>
                                {% endif %}

                                {% if not is_granted('ROLE_ADMIN') and dossier.statut == 'en_cours' and not document.estRemplace %}
                                <button type="button" class="btn btn-sm btn-outline-success btn-valider-document" data-document-id="{{ document.id }}">✓</button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-rejeter-document" data-document-id="{{ document.id }}" data-bs-toggle="modal" data-bs-target="#rejeterDocModal{{ document.id }}">✗</button>
                                {% endif %}
                            </div>
                        </div>
                        {% if document.statut == 'rejete' and document.motifRejet %}
                        <p class="text-muted small mt-1 mb-0">Motif : {{ document.motifRejet }}</p>
                        {% endif %}
                    </li>

                    {% if not is_granted('ROLE_ADMIN') %}
                    <div class="modal fade" id="rejeterDocModal{{ document.id }}" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Rejeter ce document</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <label class="form-label">Motif du rejet</label>
                                    <textarea class="form-control motif-rejet-input" rows="3"></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                    <button type="button" class="btn btn-danger btn-confirmer-rejet" data-document-id="{{ document.id }}" data-bs-dismiss="modal">Confirmer le rejet</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="refuserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Refuser le dossier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="{{ path('app_admin_dossier_refuser', {'id': dossier.id}) }}">
                <div class="modal-body">
                    <label for="motif" class="form-label">Motif du refus</label>
                    <textarea name="motif" id="motif" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Confirmer le refus</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    $(document).on('click', '.btn-valider-document', function() {
        var documentId = $(this).data('document-id');
        var url = '{{ path('app_admin_dossier_index') }}/document/' + documentId + '/valider';

        $.ajax({
            url: url,
            method: 'POST',
            success: function() {
                window.location.reload();
            }
        });
    });

    $(document).on('click', '.btn-confirmer-rejet', function() {
        var documentId = $(this).data('document-id');
        var motif = $('#rejeterDocModal' + documentId + ' .motif-rejet-input').val();

        if (!motif) {
            alert('Le motif est obligatoire.');
            return;
        }

        var url = '{{ path('app_admin_dossier_index') }}/document/' + documentId + '/rejeter';

        $.ajax({
            url: url,
            method: 'POST',
            data: { motif: motif },
            success: function(response) {
                if (response.success) {
                    window.location.reload();
                } else {
                    alert(response.message);
                }
            }
        });
    });
});
</script>
{% endblock %}
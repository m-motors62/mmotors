{% extends 'admin/base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
<h1 class="h3 mb-4">Clients</h1>

<table class="table table-striped bg-white" id="client-table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Statut</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for client in clients %}
        <tr>
            <td>{{ client.contact.prenom }} {{ client.contact.nom }}</td>
            <td>{{ client.contact.email }}</td>
            <td>{{ client.contact.telephone }}</td>
            <td>
                {% if client.isVerified %}
                    <span class="badge bg-success">Vérifié</span>
                {% else %}
                    <span class="badge bg-secondary">Non vérifié</span>
                {% endif %}
            </td>
            <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-danger btn-delete-client" data-client-id="{{ client.id }}">Supprimer</button>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="4" class="text-center text-muted">Aucun client enregistré.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    $('#client-table').DataTable({
        language: {
            search: "Rechercher :",
            lengthMenu: "Afficher _MENU_ clients",
            info: "_START_ à _END_ sur _TOTAL_ clients",
            infoEmpty: "Aucun client",
            paginate: { previous: "Précédent", next: "Suivant" },
            zeroRecords: "Aucun client ne correspond à la recherche"
        }
    });

    $(document).on('click', '.btn-delete-client', function() {
        if (!confirm('Supprimer definitivement ce client ? Cette action est irreversible.')) {
            return;
        }

        var clientId = $(this).data('client-id');
        var url = '{{ path('app_admin_client_index') }}/' + clientId + '/supprimer';

        $.ajax({
            url: url,
            method: 'POST',
            success: function(response) {
                if (response.success) {
                    window.location.reload();
                }
            },
            error: function(xhr) {
                alert(xhr.responseJSON.message);
            }
        });
    });
});
</script>
{% endblock %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}M-Motors Admin{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f3f4f6; color: #374151; }
        .navbar { background-color: #1e3a8a !important; }
        .sidebar { background-color: #ffffff; min-height: calc(100vh - 56px); border-right: 1px solid #e5e7eb; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-dark">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold">M-Motors — Back-office</span>
            {% if app.user %}
            <div class="d-flex align-items-center">
                <span class="text-white me-3">{{ app.user.contact.prenom }} {{ app.user.contact.nom }}</span>
                <a href="{{ path('app_admin_logout') }}" class="btn btn-outline-light btn-sm">Déconnexion</a>
            </div>
            {% endif %}
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            {% if app.user %}
            <nav class="col-md-2 sidebar py-3">
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_vehicule_index') }}">Véhicules</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Dossiers</a></li>
                    {% if is_granted('ROLE_GESTIONNAIRE') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_user_index') }}">Utilisateurs</a></li>
                    {% endif %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_action_log_index') }}">Journal</a></li>
                </ul>
            </nav>
            <main class="col-md-10 py-4">
            {% else %}
            <main class="col-12 py-4">
            {% endif %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
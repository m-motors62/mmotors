{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Utilisateurs</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal">
        Nouvel utilisateur
    </button>
</div>

<div id="user-table-container">
    {% include 'admin/user/_table.html.twig' %}
</div>

<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nouvel utilisateur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="form-errors" class="alert alert-danger d-none"></div>
                <div id="user-form-container">
                    <!-- Le formulaire sera charge ici via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modifier l'utilisateur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="user-edit-form-container">
                    <!-- Le formulaire sera charge ici via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    // Ouverture modale creation (deja existant)
    $('[data-bs-target="#userModal"]').on('click', function() {
        $.get('{{ path('app_admin_user_new') }}', function(html) {
            $('#user-form-container').html(html);
        });
    });

    // Soumission formulaire creation (deja existant)
    $(document).on('submit', '#user-form', function(e) {
        e.preventDefault();
        var $form = $(this);

        $.ajax({
            url: '{{ path('app_admin_user_new') }}',
            method: 'POST',
            data: $form.serialize(),
            success: function(response) {
                if (response.success) {
                    $('#user-table-container').html(response.html);
                    $('#userModal').modal('hide');
                    $('#user-form-container').html('');

                    if (!response.emailSent) {
                        alert('Utilisateur cree, mais l\'envoi de l\'email a echoue. Verifiez la configuration SMTP.');
                    }
                }
            },
            error: function(xhr) {
                var response = xhr.responseJSON;
                $('#user-form-container').html(response.html);
            }
        });
    });

    // Ouverture modale edition
    $(document).on('click', '.btn-edit-user', function() {
        var userId = $(this).data('user-id');
        var editUrl = '{{ path('app_admin_user_index') }}/' + userId + '/modifier';

        $.get(editUrl, function(html) {
            $('#user-edit-form-container').html(html);
            $('#editUserModal').modal('show');
        });
    });

    // Soumission formulaire edition
    $(document).on('submit', '#user-edit-form', function(e) {
        e.preventDefault();
        var $form = $(this);
        var userId = $form.data('user-id');
        var editUrl = '{{ path('app_admin_user_index') }}/' + userId + '/modifier';

        $.ajax({
            url: editUrl,
            method: 'POST',
            data: $form.serialize(),
            success: function(response) {
                if (response.success) {
                    $('#user-table-container').html(response.html);
                    $('#editUserModal').modal('hide');
                    $('#user-edit-form-container').html('');
                }
            },
            error: function(xhr) {
                var response = xhr.responseJSON;
                $('#user-edit-form-container').html(response.html);
            }
        });
    });

    $(document).on('click', '.btn-resend-link', function() {
        var userId = $(this).data('user-id');
        var url = '{{ path('app_admin_user_index') }}/' + userId + '/renvoyer-lien';

        if (!confirm('Envoyer un nouveau lien de definition de mot de passe a cet utilisateur ?')) {
            return;
        }

        $.ajax({
            url: url,
            method: 'POST',
            success: function(response) {
                if (response.emailSent) {
                    alert('Lien envoye avec succes.');
                } else {
                    alert('Utilisateur mis a jour, mais l\'envoi de l\'email a echoue.');
                }
            }
        });
    });
});
</script>
{% endblock %}
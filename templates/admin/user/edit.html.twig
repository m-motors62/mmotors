{% extends 'admin/base.html.twig' %}

{% block title %}Modifier {{ user.contact.prenom }} {{ user.contact.nom }}{% endblock %}

{% block body %}
<h1 class="h3 mb-4">Modifier {{ user.contact.prenom }} {{ user.contact.nom }}</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.prenom) }}
            {{ form_row(form.email) }}
            {{ form_row(form.role) }}
            <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
<table class="table table-striped bg-white">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Rôles</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.contact.prenom }} {{ user.contact.nom }}</td>
            <td>{{ user.email }}</td>
            <td>
                {% for role in user.roles %}
                    {% if role != 'ROLE_USER' %}
                        <span class="badge bg-secondary">
                            {{ {
                                'ROLE_ADMIN': 'Administrateur',
                                'ROLE_GESTIONNAIRE': 'Gestionnaire (RH)',
                                'ROLE_COMMERCIAL': 'Commercial'
                            }[role] ?? role }}
                        </span>
                    {% endif %}
                {% endfor %}
            </td>
            <td>
                {% if user.isActive %}
                    <span class="badge bg-success">Actif</span>
                {% else %}
                    <span class="badge bg-secondary">Désactivé</span>
                {% endif %}
            </td>
            <td>
                {% if user.canBeManagedBy(app.user) %}
                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit-user" data-user-id="{{ user.id }}">Modifier</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-resend-link" data-user-id="{{ user.id }}">Renvoyer le lien</button>
                {% else %}
                    <span class="text-muted small">—</span>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
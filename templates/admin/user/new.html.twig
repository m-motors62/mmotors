{% extends 'admin/base.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block body %}
<h1 class="h3 mb-4">Nouvel utilisateur</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.prenom) }}
            {{ form_row(form.email) }}
            {{ form_row(form.password) }}
            {{ form_row(form.role) }}
            <button type="submit" class="btn btn-primary mt-3">Créer l'utilisateur</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card mt-5">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Mot de passe oublié</h1>
                <p class="text-muted small">Entrez votre email pour recevoir un lien de reinitialisation.</p>
                {{ form_start(form) }}
                    {{ form_row(form.email) }}
                    <button type="submit" class="btn btn-primary w-100 mt-3">Envoyer</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
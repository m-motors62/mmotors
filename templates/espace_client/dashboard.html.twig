{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}
<h1 class="h4 mb-4">Bonjour {{ app.user.contact.prenom }}</h1>

<div class="row g-3">
    <div class="col-md-4">
        <a href="{{ path('app_espace_client_profile') }}" class="text-decoration-none">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Mon profil</h2>
                    <p class="text-muted small mb-0">Modifier mes informations personnelles</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="{{ path('app_espace_client_dossiers') }}" class="text-decoration-none">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Mes dossiers</h2>
                    <p class="text-muted small mb-0">Suivre l'avancement de mes demandes</p>
                </div>
            </div>
        </a>
    </div>
</div>
{% endblock %}